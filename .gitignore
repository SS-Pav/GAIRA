# ============================================================================
# GAIRA_Core — .gitignore
#
# GAIRA_Core is the frozen, portable scientific product: source, the frozen
# foundation model (assets/foundation/), demos, reports, figures, tables and the
# reproducible audit. It must clone-and-run with NO SSD_Rad / lab dependency.
#
# Policy: IGNORE only raw/lab data, machine-specific files, and regenerable
# intermediate artifacts. NEVER ignore scientific assets (reports, figures,
# tables, models, npz, csv, json, md) — they are the product.
# ============================================================================

# ── Raw / laboratory data (lives in GAIRA_Lab / SSD_Rad, never in Core) ──
data/
GAIRA_DATA/
/Volumes/
*.mat
*.rar

# ── Python ──
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
build/
dist/
.eggs/

# ── Virtual environments ──
.venv/
.venv_old_migrated/
venv/
env/
ENV/

# ── Notebooks ──
.ipynb_checkpoints/

# ── OS / editor ──
.DS_Store
Thumbs.db
.idea/
.vscode/

# ── Agent / machine-specific ──
.claude/
.claude_cache/
.claude_logs/
mcp_logs/

# ── Secrets ──
.env
.env.*
*.secrets
credentials/
.streamlit/secrets.toml

# ── Logs & scratch (regenerable) ──
logs/
*.log
/tmp/
tmp/
*.tmp

# ── Databases / caches (regenerable) ──
*.duckdb
*.sqlite
*.db
*_audit_store.pkl
.matplotlib-cache/

# ── V5 reproduction — temporary run outputs (regenerable; canonical examples are kept
#    under results/v5_rebuild/reproduction/example_outputs/ and manifests/) ──
/results/reproduction/
results/v5_rebuild/reproduction/tmp_full_rebuild/
results/v5_rebuild/reproduction/verification/*_run/

# ── Intermediate / lab training artifacts (belong in GAIRA_Lab) ──
results/v5_rebuild/phase2_stage_b/models/
runs/
checkpoints/

# ── Binary document exports (the .md source is tracked instead) ──
*.pdf
*.docx
*.pptx

# ...except the per-phase V7 figure reports, which ARE a deliverable: each phase from 02.5
# onward ships one PDF carrying all its figures with captions, and that is the artefact people
# read away from the repository.
!results/v7_rebuild/*/reports/*.pdf
# the V7 architecture documents are deliverables, not build output
!GAIRA_v7_rebuild/reports/*.pdf

# NOTE ON SCIENTIFIC ASSETS
# The following are DELIBERATELY tracked (do NOT add ignore rules for them):
#   *.npz *.npy  (frozen NMF basis, reference support)
#   *.csv *.json (tables, registries, weights, metadata)
#   *.png        (figures)
#   *.md         (reports, documentation)
#   reports/ figures/ tables/ components/ assets/foundation/
